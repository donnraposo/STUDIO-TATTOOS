# Copie para .env e ajuste. Nunca versione o .env com valores reais.

ENVIRONMENT=development
DEBUG=false

# Senha das contas de demonstracao criadas por backend/scripts/seed_demo.py.
# Vale SOMENTE em desenvolvimento: o script se recusa a rodar com ENVIRONMENT
# diferente de development, porque criar contas com senha conhecida em producao
# seria abrir o sistema para quem souber ler este arquivo.
SEED_DEMO_PASSWORD=studio-demo-2026

STUDIO_TIMEZONE=Europe/Dublin

POSTGRES_DB=tattoo_studio
POSTGRES_USER=tattoo_studio
POSTGRES_PASSWORD=tattoo_studio
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Armazenamento privado de arquivos (ADR-006, revisto na M4.3).
# Diretorio dentro do volume nomeado do container; nao e caminho do host.
# ATENCAO: a copia de seguranca precisa levar este diretorio, alem do pg_dump.
STORAGE_ROOT=/var/lib/tattoo-studio/objects

# Limites das imagens de referencia do orcamento (RN-ORC-004).
REFERENCE_IMAGE_MAX_BYTES=10485760
REFERENCE_IMAGE_ALLOWED_TYPES=image/jpeg,image/png,image/webp
REFERENCE_IMAGE_MAX_PER_QUOTE=10
